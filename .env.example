# Copy to .env.local for local development, and set the same variables in Vercel → Project → Settings → Environment Variables.
# Only PUBLIC values go here. The browser must never receive a service-role / secret key.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable (anon) key — safe to ship to the browser; Row Level Security protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: campaign content on the Introduction screen (defaults live in src/lib/campaign.js)
# VITE_KNOW_MORE_URL=https://www.zopper.com
# VITE_TERMS_URL=
# VITE_CAMPAIGN_DATES=Challenge runs till 31 December 2026. Winners announced in January.

# ---------------------------------------------------------------------------------------------------------------
# NOT used by the front end — these are Supabase Edge Function SECRETS. Set them with scripts/configure-phone-auth.mjs
# (or: supabase secrets set …). NEVER put them in a VITE_ variable, in React code or in git.
#   WATI_API_TOKEN, WATI_API_BASE_URL, WATI_AUTH_TEMPLATE_NAME, WATI_AUTH_TEMPLATE_LANGUAGE   WhatsApp OTP delivery (WATI)
#   SEND_SMS_HOOK_SECRET                                                                      signs the Auth Hook (generated for you)
#   SEND_SMS_DRY_RUN=1 / SEND_SMS_SKIP_NUMBERS=…                                              optional staging / test safety
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY                                                  injected automatically by Supabase
#   BREVO_API_KEY | SMTP_*  EMAIL_FROM …                                                      optional thank-you email (legacy players)
# See README.md → "WhatsApp OTP setup (WATI)".
# ---------------------------------------------------------------------------------------------------------------
